# Pipeline. Copy to pipeline/.env and fill in; real environment variables win.

# Match data, research, voices
RAPIDAPI_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=

# PUBLISH writes episodes and audio here (same project as the website)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Models default to claude-code:* (the `claude` CLI and its logged-in
# subscription). Only needed if you switch a role to another provider:
# ANTHROPIC_API_KEY=      # anthropic:<model>
# DEEPSEEK_API_KEY=       # deepseek:<model>
# OPENAI_API_KEY=         # openai:<model>

# Optional overrides, see atp_pipeline/config.py
# RESEARCH_MODEL=claude-code:sonnet
# REVIEWER_MODEL=claude-code:opus
# ELEVENLABS_VOICE_ALEX=
# ELEVENLABS_VOICE_SAM=
