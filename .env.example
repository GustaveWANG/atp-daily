# Website (Next.js). Copy to .env.local and fill in.
# The site reads Supabase server-side only, with the service role key: never
# expose it to the browser or commit it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
SITE_URL=                 # canonical origin, e.g. https://example.com (default: from the request)
PODCAST_OWNER_EMAIL=      # <itunes:owner> email in feed.xml
