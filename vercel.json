{
  "functions": {
    "pages/api/cron/generate-content.ts": { "maxDuration": 300 },
    "pages/api/cron/generate-audio.ts": { "maxDuration": 300 },
    "pages/api/recap.ts": { "maxDuration": 30 },
    "pages/api/podcast.ts": { "maxDuration": 60 },
    "pages/api/tts.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/generate-content",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-audio",
      "schedule": "15 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
